{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "llm-eval run 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_sha256",
    "attempts_per_case",
    "provenance",
    "configurations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "benchmark_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "attempts_per_case": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "provenance": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "synthetic",
            "measured",
            "imported"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "configurations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "configuration_id",
          "records"
        ],
        "properties": {
          "configuration_id": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "parameters": {
            "type": "object"
          },
          "environment": {
            "type": "object"
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "case_id",
                "attempt",
                "status",
                "response"
              ],
              "properties": {
                "case_id": {
                  "type": "string",
                  "minLength": 1
                },
                "attempt": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "status": {
                  "enum": [
                    "success",
                    "error"
                  ]
                },
                "response": {
                  "type": "string",
                  "maxLength": 1000000
                },
                "response_sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{64}$"
                },
                "elapsed_seconds": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "cost_eur": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "output_tokens": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100000000
                }
              }
            }
          }
        }
      }
    }
  }
}
